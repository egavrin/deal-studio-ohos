  "source": "import * as ui from \"std/ui\"\n@jsonable class AppState { remaining: int; running: boolean; }\nfunction init(): AppState { return {remaining: 90000, running: false}; }\nfunction start(state: AppState, value: int): AppState { return {remaining: state.remaining, running: true}; }\nfunction tick(state: AppState, elapsedMs: int): AppState { let left: int = state.remaining - elapsedMs; if (left < 0) { left = 0; } return {remaining: left, running: left > 0}; }\nfunction view(state: AppState): ui.View { return ui.AppTheme(\"soft\", \"\", [ui.Section(\"content\", \"Take a quiet break\", \"A ninety-second pause\", [ui.IntText(\"metric\", state.remaining / 1000, \"\", \" seconds\", 1), ui.ActionBar(\"default\", [ui.Button(\"primary\", \"Start\", \"start\", 0, true)]), ui.Ticker(\"default\", \"clock\", 1000, state.running, \"tick\")])]); }\n",
