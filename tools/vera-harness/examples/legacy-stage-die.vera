import * as ui from "std/ui"
import * as math from "std/math"

@jsonable
class AppState { turnX: number; turnY: number; rolls: number; seed: number; }

function init(): AppState { return { turnX: 0, turnY: 0, rolls: 0, seed: 7 }; }

function pips(n: number): string {
  if (n === 1) { return "M50 40 A10 10 0 1 1 50 60 A10 10 0 1 1 50 40 Z"; }
  return "M25 15 A10 10 0 1 1 25 35 A10 10 0 1 1 25 15 Z M75 65 A10 10 0 1 1 75 85 A10 10 0 1 1 75 65 Z";
}

function faceView(n: number): ui.View {
  return ui.Canvas("large", [
    ui.Path("light", "M0 0 L100 0 L100 100 L0 100 Z", 0),
    ui.Path("default", pips(n), 0)
  ]);
}

function face(turnX: number, turnY: number, n: number): ui.View {
  return ui.Transform("default", [turnX, turnY], 0, 0, [
    ui.Transform("solid", [0, 0, 0, 0, 0, 60], 0, 120, [faceView(n)])
  ]);
}

function onRoll(state: AppState, _v: number): AppState {
  let next: number = math.randomStep(state.seed);
  let n: number = math.randomBelow(next, 6) + 1;
  return { turnX: state.turnX + 720, turnY: state.turnY + 720 + n * 30, rolls: state.rolls + 1, seed: next };
}

function view(state: AppState): ui.View {
  return ui.AppTheme("clean", "", [
    ui.Column("spacious", [
      ui.Stage("floor", 0, 260, [
        ui.Transform("default", [state.turnX, state.turnY], 900, 0, [
          face(0, 0, 1), face(0, 180, 6), face(0, 90, 3),
          face(0, -90, 4), face(90, 0, 2), face(-90, 0, 5)
        ])
      ]),
      ui.Button("primary", "Roll", "onRoll", 0, true)
    ])
  ]);
}
