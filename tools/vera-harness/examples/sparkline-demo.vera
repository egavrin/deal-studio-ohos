import * as ui from "std/ui"

@jsonable
class AppState {
  nothing: int;
}

function init(): AppState {
  return { nothing: 0 };
}

function view(state: AppState): ui.View {
  return ui.AppTheme("clean", "", [
    ui.Column("spacious", [
      ui.Header("default", "Steps this week", "", "", ""),
      ui.Sparkline("accent", [3200, 5400, 4100, 7800, 6200, 9100, 5000], 10000, "Mon-Sun")
    ])
  ]);
}
